# ---- Backend environment (copy to .env, never commit .env) ----
PORT=5000
NODE_ENV=development
# Your own MongoDB Atlas (free M0) or local connection string
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/veloop_streak?retryWrites=true&w=majority
# Long random string, e.g. output of: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d
# Frontend origin(s) allowed by CORS, comma separated
CLIENT_ORIGIN=http://localhost:5173
# Mongo transactions need a replica set (Atlas has one). Set false for a plain local mongod.
USE_TRANSACTIONS=true
# Dev-only helper routes (time rewind for missed-day tests). Keep false in production.
ALLOW_DEV_ROUTES=false
